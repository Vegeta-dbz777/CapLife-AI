# Copy to .streamlit/secrets.toml (ignored by Git) to run sign-in and saving locally.
# On Streamlit Cloud, paste the same sections into the app's Settings -> Secrets.
# See docs/accounts-and-storage.md.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "your-google-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[storage]
# Local development can use SQLite instead of PostgreSQL.
url = "sqlite:///caplife_local.db"
